{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistola.app/schemas/resource-detail-v8.schema.json",
  "title": "ResourceDetail",
  "description": "Portable Epistola resource detail at wire version 8.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 8
    },
    "resource": {
      "$ref": "#/$defs/CatalogResource"
    }
  },
  "required": [
    "schemaVersion",
    "resource"
  ],
  "additionalProperties": false,
  "$defs": {
    "CatalogResource": {
      "oneOf": [
        {
          "$ref": "#/$defs/TemplateResource"
        },
        {
          "$ref": "#/$defs/ThemeResource"
        },
        {
          "$ref": "#/$defs/StencilResource"
        },
        {
          "$ref": "#/$defs/AttributeResource"
        },
        {
          "$ref": "#/$defs/ImageResource"
        },
        {
          "$ref": "#/$defs/CodeListResource"
        },
        {
          "$ref": "#/$defs/FontResource"
        }
      ]
    },
    "TemplateResource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "template"
        },
        "key": {
          "description": "The resource's key: its public address within its catalog. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "name": {
          "type": "string"
        },
        "description": {
          "description": "Plain text for the template's authors and readers: what it is for, design decisions, known gaps. Not rendered. When the manifest's resource entry also carries a description, the two must be equal; this is the source.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "themeKey": {
          "description": "Key of the template's default theme. Qualified by themeCatalogKey, themeNamespace and themeRegistry when the theme lives in another catalog. Until wire v8 this member was called themeId.",
          "type": [
            "string",
            "null"
          ]
        },
        "themeCatalogKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "themeNamespace": {
          "description": "Namespace of the catalog holding the theme. Omitted means the template's own catalog namespace.",
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "themeRegistry": {
          "description": "Registry of the catalog holding the theme. Omitted means the template's own catalog registry, never an installation default. Requires themeNamespace.",
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "pdfaEnabled": {
          "type": "boolean",
          "default": true
        },
        "dataModel": {
          "type": [
            "object",
            "null"
          ]
        },
        "dataExamples": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DataExampleEntry"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "templateModel": {
          "$ref": "template-document.schema.json"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariantEntry"
          }
        }
      },
      "required": [
        "type",
        "key",
        "name",
        "templateModel",
        "variants"
      ],
      "dependentRequired": {
        "themeRegistry": [
          "themeNamespace"
        ]
      },
      "additionalProperties": false
    },
    "ThemeResource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "theme"
        },
        "key": {
          "description": "The resource's key: its public address within its catalog. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentStyles": {
          "type": [
            "object",
            "null"
          ]
        },
        "pageSettings": {
          "oneOf": [
            {
              "$ref": "template-shared.schema.json#/$defs/PageSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockStylePresets": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "theme.schema.json#/$defs/BlockStylePreset"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "spacingUnit": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "key",
        "name"
      ],
      "additionalProperties": false
    },
    "StencilResource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "stencil"
        },
        "key": {
          "description": "The resource's key: its public address within its catalog. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "$ref": "template-document.schema.json"
        },
        "parameterSchema": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "key",
        "name",
        "content"
      ],
      "additionalProperties": false
    },
    "AttributeResource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "attribute"
        },
        "key": {
          "description": "The resource's key: its public address within its catalog. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "name": {
          "type": "string"
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "codeListBinding": {
          "oneOf": [
            {
              "$ref": "#/$defs/CodeListBindingRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "key",
        "name"
      ],
      "additionalProperties": false
    },
    "ImageResource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "image"
        },
        "key": {
          "description": "The resource's key: its public address within its catalog. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 50
        },
        "name": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "contentUrl": {
          "type": "string",
          "deprecated": true,
          "description": "Deprecated. Where the bytes are, when the archive does not put them where the hash says. A catalog written from wire v7 omits this and files every binary at bin/<contentHash>; only an archive migrated from wire v6 or earlier still carries a path, because a migration rewrites documents and cannot move files. Read, never written. Kept in wire v8 because such archives are still in circulation. When present it is a relative path below the manifest's directory, by the same rule as a manifest detailUrl.",
          "pattern": "^(?:\\./)?(?!\\.{1,2}(?:/|$))(?:[A-Za-z0-9._~-]|%(?!2[EeFf]|5[Cc])[0-9A-Fa-f]{2})+(?:/(?!\\.{1,2}(?:/|$))(?:[A-Za-z0-9._~-]|%(?!2[EeFf]|5[Cc])[0-9A-Fa-f]{2})+)*$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "key",
        "name",
        "mediaType",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "CodeListResource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "codeList"
        },
        "key": {
          "description": "The resource's key: its public address within its catalog. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeListEntryEntry"
          }
        }
      },
      "required": [
        "type",
        "key",
        "name",
        "entries"
      ],
      "additionalProperties": false
    },
    "FontResource": {
      "type": "object",
      "properties": {
        "type": {
          "const": "font"
        },
        "key": {
          "description": "The resource's key: its public address within its catalog. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FontVariantEntry"
          }
        }
      },
      "required": [
        "type",
        "key",
        "name",
        "kind",
        "variants"
      ],
      "additionalProperties": false
    },
    "CodeListBindingRef": {
      "type": "object",
      "properties": {
        "catalogKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "Key of the code list within the catalog named by catalogKey, namespace and registry. Until wire v8 this member was called slug.",
          "type": "string"
        },
        "namespace": {
          "description": "Namespace of the catalog holding the code list. Omitted means the attribute's own catalog namespace.",
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "registry": {
          "description": "Registry of the catalog holding the code list. Omitted means the attribute's own catalog registry, never an installation default. Requires namespace.",
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        }
      },
      "required": [
        "key"
      ],
      "dependentRequired": {
        "registry": [
          "namespace"
        ]
      },
      "additionalProperties": false
    },
    "CodeListEntryEntry": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sortOrder": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "label"
      ],
      "additionalProperties": false
    },
    "FontVariantEntry": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "integer"
        },
        "italic": {
          "type": "boolean"
        },
        "mediaType": {
          "type": "string"
        },
        "contentUrl": {
          "type": "string",
          "deprecated": true,
          "description": "Deprecated. Where the bytes are, when the archive does not put them where the hash says. A catalog written from wire v7 omits this and files every binary at bin/<contentHash>; only an archive migrated from wire v6 or earlier still carries a path, because a migration rewrites documents and cannot move files. Read, never written. Kept in wire v8 because such archives are still in circulation. When present it is a relative path below the manifest's directory, by the same rule as a manifest detailUrl.",
          "pattern": "^(?:\\./)?(?!\\.{1,2}(?:/|$))(?:[A-Za-z0-9._~-]|%(?!2[EeFf]|5[Cc])[0-9A-Fa-f]{2})+(?:/(?!\\.{1,2}(?:/|$))(?:[A-Za-z0-9._~-]|%(?!2[EeFf]|5[Cc])[0-9A-Fa-f]{2})+)*$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "weight",
        "italic",
        "contentHash",
        "mediaType"
      ],
      "additionalProperties": false
    },
    "DataExampleEntry": {
      "type": "object",
      "properties": {
        "key": {
          "description": "The example's key: its address within its template, unique there. A v7 example had none; the v7-to-v8 migration derives one from its name.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "description": "The example's display name, unique within its template.",
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "key",
        "name",
        "data"
      ],
      "additionalProperties": false
    },
    "VariantEntry": {
      "type": "object",
      "properties": {
        "key": {
          "description": "The variant's key: its public address within its template. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "templateModel": {
          "oneOf": [
            {
              "$ref": "template-document.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "isDefault": {
          "type": "boolean"
        },
        "metadata": {
          "description": "Producer-specific data the contract carries but does not define, by namespace. Each property name is a reverse-DNS namespace the producer owns (app.epistola.suite); only that producer writes into it, and every other reader keeps it as it is. Each value is a JSON object the contract does not interpret. Omitted rather than empty. A release is immutable, so the values are fixed with it. At most 8 KiB serialized per variant, which the validator checks.",
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$": {
              "type": "object"
            }
          },
          "propertyNames": {
            "maxLength": 100
          },
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 16
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    }
  }
}
