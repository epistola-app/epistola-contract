{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistola.app/schemas/catalog-manifest-v8.schema.json",
  "title": "CatalogManifest",
  "description": "Portable Epistola catalog manifest at wire version 8.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 8
    },
    "catalog": {
      "$ref": "#/$defs/CatalogInfo"
    },
    "publisher": {
      "$ref": "#/$defs/PublisherInfo"
    },
    "release": {
      "$ref": "#/$defs/ReleaseInfo"
    },
    "compatibility": {
      "oneOf": [
        {
          "$ref": "#/$defs/CompatibilityInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "includes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IncludeEntry"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceEntry"
      }
    },
    "dependencies": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyRef"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "catalogDependencies": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogDependency"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "catalog",
    "publisher",
    "release",
    "resources"
  ],
  "additionalProperties": false,
  "$defs": {
    "CatalogInfo": {
      "type": "object",
      "properties": {
        "registry": {
          "$ref": "#/$defs/CatalogRegistry"
        },
        "namespace": {
          "$ref": "#/$defs/CatalogNamespace"
        },
        "key": {
          "description": "The catalog's key: its public address within its namespace. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttributeAssignment"
          }
        },
        "keywords": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CatalogKeyword"
              },
              "maxItems": 20,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation": {
          "oneOf": [
            {
              "$ref": "#/$defs/CatalogPresentation"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "oneOf": [
            {
              "$ref": "#/$defs/CatalogLicense"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "registry",
        "namespace",
        "key",
        "name"
      ],
      "additionalProperties": false
    },
    "CatalogRegistry": {
      "description": "The registry a catalog's namespace lives in: an exchange (exchange.epistola.app) or a domain that publishes its own catalogs (acme.com), as a lowercase DNS name in normal order. Always written in full: an archive has no default registry, which is installation configuration.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "CatalogNamespace": {
      "description": "A catalog namespace within its registry, as a lowercase kebab-case slug (acme-corp). The same name in two registries is two different namespaces.",
      "type": "string",
      "minLength": 3,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "CatalogKeyword": {
      "description": "Lowercase ASCII letters and digits in hyphen-separated parts, at most 30 characters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "AttributeAssignment": {
      "type": "object",
      "properties": {
        "catalogKey": {
          "description": "Key of the catalog defining the attribute. Until wire v8 this member was called catalog.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "catalogKey",
        "key",
        "value"
      ],
      "additionalProperties": false
    },
    "CatalogPresentation": {
      "type": "object",
      "properties": {
        "iconImageKey": {
          "description": "Key of the image resource in this catalog that serves as the catalog's icon. Until wire v8 this member was called iconAssetSlug.",
          "type": [
            "string",
            "null"
          ]
        },
        "imageKeys": {
          "description": "Keys of the image resources in this catalog shown in its gallery, in order. Until wire v8 this member was called imageAssetSlugs.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "CatalogLicense": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "spdxExpression": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://\\S+$"
        },
        "copyrightText": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\S(?:.*\\S)?$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "PublisherInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "ReleaseInfo": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "releasedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "description": "The canonical fingerprint of the release's content, in the form that names its algorithm: v5:<lowercase SHA-256 hex>. Wire v8 requires the current algorithm, v5.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v[1-9][0-9]*:[0-9a-f]{64}$"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "CompatibilityInfo": {
      "type": "object",
      "properties": {
        "epistolaVersions": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "IncludeEntry": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "ResourceEntry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "key": {
          "description": "The resource's key: its public address within the catalog and its type. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "detailUrl": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "key",
        "name",
        "detailUrl"
      ],
      "additionalProperties": false
    },
    "DependencyRef": {
      "description": "Every dependency names a catalog (registry, namespace and key) from wire v8, so this is exactly CatalogDependencyRef. A dependency carries no version; the catalog it names must be declared in catalogDependencies.",
      "oneOf": [
        {
          "$ref": "#/$defs/CatalogDependencyRef"
        }
      ]
    },
    "CatalogDependencyRef": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "theme",
            "stencil",
            "codeList",
            "font",
            "image"
          ]
        },
        "registry": {
          "$ref": "#/$defs/CatalogRegistry"
        },
        "namespace": {
          "$ref": "#/$defs/CatalogNamespace"
        },
        "catalogKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "key": {
          "description": "Key of the resource within the catalog named by registry, namespace and catalogKey. Until wire v8 this member was called slug.",
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "type",
        "registry",
        "namespace",
        "catalogKey",
        "key"
      ],
      "additionalProperties": false
    },
    "CatalogDependency": {
      "description": "A catalog this catalog depends on, declared once. References from this catalog's resources into it carry no version: they render with the release this declaration resolves to.",
      "type": "object",
      "properties": {
        "registry": {
          "$ref": "#/$defs/CatalogRegistry"
        },
        "namespace": {
          "$ref": "#/$defs/CatalogNamespace"
        },
        "catalogKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 50
        },
        "version": {
          "description": "The declared version selector, in the npm SemVer range grammar (an exact version, ^, ~, comparators, a hyphen range, a || union, or *).",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "releaseVersion": {
          "description": "The exact release of the dependency this archive's release was cut with. Null only for a catalog migrated from wire v7 or earlier, and then releaseFingerprint is null too.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        },
        "releaseFingerprint": {
          "description": "The fingerprint of the release releaseVersion names, copied from that release's own release.fingerprint, in the form that names its algorithm (v5:<lowercase SHA-256 hex>), so a copy of that release fetched from any registry or mirror can be checked with exactly that algorithm. Null exactly when releaseVersion is null.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v[1-9][0-9]*:[0-9a-f]{64}$"
        }
      },
      "required": [
        "registry",
        "namespace",
        "catalogKey",
        "version",
        "releaseVersion",
        "releaseFingerprint"
      ],
      "if": {
        "properties": {
          "releaseVersion": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "releaseFingerprint": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "releaseFingerprint": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
