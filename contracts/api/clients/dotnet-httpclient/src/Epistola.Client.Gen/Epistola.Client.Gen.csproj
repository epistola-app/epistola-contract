<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time generator that reads the bundled OpenAPI spec and emits the three
    derived source files (KnownProblemSlugs, ModelValidation, ContractVersion) into
    the main project's Generated/ folder. Invoked by generate.sh. This is the .NET
    analogue of the Kotlin build's generateProblemSlugs / generateValidation /
    generateContractVersionResource Gradle tasks.

    It is NOT packed or shipped — it is a developer/CI build tool only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Epistola.Client.Gen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
