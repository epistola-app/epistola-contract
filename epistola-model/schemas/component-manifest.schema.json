{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistola.app/schemas/component-manifest.schema.json",
  "title": "ComponentRegistry",
  "description": "Registry defining the static component vocabulary supported by the Epistola editor model.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for the registry file."
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/ComponentManifest" },
      "minItems": 1,
      "description": "Component descriptors keyed by each node type's discriminator."
    }
  },
  "required": ["schemaVersion", "components"],
  "additionalProperties": false,
  "$defs": {
    "ComponentManifest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Unique type identifier matching Node.type."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable display name for the palette and tree."
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier, usually a Lucide icon name."
        },
        "category": {
          "type": "string",
          "enum": ["content", "layout", "logic", "page"],
          "description": "Category for palette grouping."
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Whether this component is hidden from direct insertion."
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/SlotTemplate" },
          "description": "Slot templates created when this node type is instantiated."
        },
        "allowedChildren": {
          "$ref": "#/$defs/AllowedChildren",
          "description": "Constraints on which node types can be placed in this node's slots."
        },
        "applicableStyles": {
          "$ref": "#/$defs/ApplicableStyles",
          "description": "Which style properties are allowed on this node type."
        },
        "inspector": {
          "type": "array",
          "items": { "$ref": "#/$defs/InspectorField" },
          "description": "Inspector panel field configuration for editing node props."
        },
        "defaultStyles": {
          "type": "object",
          "description": "Default styles applied to nodes of this type."
        },
        "defaultProps": {
          "type": "object",
          "description": "Default props applied when creating a new node of this type."
        },
        "maxInstancesPerDocument": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional per-document instance limit."
        },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentExample" },
          "description": "Curated TemplateDocument fragments showing realistic usage."
        },
        "parameters": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": true
            }
          ],
          "description": "Parameter schema metadata. Null means dynamic per node; an object is a static JSON Schema."
        }
      },
      "required": [
        "type",
        "label",
        "category",
        "hidden",
        "slots",
        "allowedChildren",
        "applicableStyles",
        "inspector"
      ],
      "additionalProperties": false
    },
    "SlotTemplate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Slot name."
        },
        "dynamic": {
          "type": "boolean",
          "default": false,
          "description": "If true, the slot name is a pattern and slots are created dynamically."
        },
        "locked": {
          "type": "boolean",
          "description": "If true, descendants in this slot are locked unless an inner slot is editable."
        },
        "editable": {
          "type": "boolean",
          "description": "If true, this slot breaks an inherited lock."
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "AllowedChildren": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": { "const": "all" }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "allowlist" },
            "types": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["mode", "types"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "denylist" },
            "types": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["mode", "types"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "none" }
          },
          "required": ["mode"],
          "additionalProperties": false
        }
      ]
    },
    "ApplicableStyles": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "InspectorField": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Property key in node.props."
        },
        "label": {
          "type": "string",
          "description": "Display label for the inspector field."
        },
        "type": {
          "type": "string",
          "enum": ["text", "number", "boolean", "select", "expression", "json", "color", "unit"]
        },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/InspectorOption" }
        },
        "defaultValue": {
          "type": ["array", "boolean", "integer", "number", "object", "string", "null"],
          "description": "Default value for this field when creating new nodes."
        },
        "units": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["key", "label", "type"],
      "additionalProperties": false
    },
    "InspectorOption": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": {}
      },
      "required": ["label", "value"],
      "additionalProperties": false
    },
    "ComponentExample": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fragment": {
          "$ref": "#/$defs/ComponentExampleFragment"
        }
      },
      "required": ["name", "description", "fragment"],
      "additionalProperties": false
    },
    "ComponentExampleFragment": {
      "type": "object",
      "properties": {
        "rootNodeId": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "slots": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      },
      "required": ["rootNodeId", "nodes", "slots"],
      "additionalProperties": false
    }
  }
}
